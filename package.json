{
  "name": "otaxi-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "OTAXI — Intercity & Cross-Border Ridesharing Platform for Central Asia",
  "packageManager": "pnpm@10.12.2",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:backend": "turbo dev --filter=@otaxi/backend",
    "dev:mobile": "turbo dev --filter=@otaxi/mobile",
    "dev:admin": "turbo dev --filter=@otaxi/web-admin",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "clean": "turbo clean && rm -rf node_modules",
    "backend:seed": "pnpm --filter @otaxi/backend prisma:seed"
  },
  "devDependencies": {
    "prettier": "^3.5.0",
    "turbo": "^2.4.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  }
}
