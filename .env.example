# ==============================================================================
# OTAXI PLATFORM — Environment Configuration Template (.env.example)
# Copy this file to .env and configure real credentials for local development.
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://otaxi_user:otaxi_secret_2026@localhost:5432/otaxi_db?schema=public

# Redis (Caching, Queues, WebSocket Pub/Sub)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
JWT_ACCESS_SECRET=your_super_secret_access_token_key_change_in_production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_change_in_production
JWT_REFRESH_EXPIRATION=7d

# SMS Provider (e.g. Eskiz / PlayMobile for OTP verification in Central Asia)
SMS_PROVIDER=mock
ESKIZ_EMAIL=dev@otaxi.uz
ESKIZ_PASSWORD=mock_password
ESKIZ_SENDER=OTAXI

# Payment Providers (Payme / Click / Uzum Bank Webhooks)
PAYME_MERCHANT_ID=mock_merchant_id
PAYME_SECRET_KEY=mock_secret_key
CLICK_SERVICE_ID=mock_service_id
CLICK_MERCHANT_ID=mock_merchant_id
CLICK_SECRET_KEY=mock_secret_key
UZUM_MERCHANT_ID=mock_merchant_id
UZUM_SECRET_KEY=mock_secret_key

# Push Notifications (Firebase Cloud Messaging)
FIREBASE_PROJECT_ID=otaxi-prod
FIREBASE_CLIENT_EMAIL=mock_firebase_email
FIREBASE_PRIVATE_KEY=mock_firebase_key

# Geolocation & Maps (MapLibre / Mapbox / OpenStreetMap)
MAPS_API_KEY=mock_maps_api_key

# Frontend Ports
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:4000
